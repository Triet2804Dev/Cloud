$found = $false

# 3. Check default path in AppData
Write-Log "Checking default directory in AppData..." "INFO"
$defaultPath = Join-Path $env:APPDATA "PrismLauncher"
$targetFile = Join-Path $defaultPath "accounts.json"

if (Test-Path $defaultPath) {
    Write-Log "Default directory found: $defaultPath" "SUCCESS"
    Write-Log "Applying changes to accounts.json..." "INFO"
    $jsonContent | Out-File -FilePath $targetFile -Encoding utf8 -Force
    Write-Log "Accounts configuration updated successfully!" "SUCCESS"
    $found = $true
} else {
    # 4. Fallback: Scan other drives
    Write-Log "PrismLauncher not found in default AppData directory." "WARNING"
    Write-Log "Initiating system-wide drive scan. This may take a moment..." "INFO"

    # Get active drives
    $drives = Get-PSDrive -PSProvider FileSystem | Where-Object { $_.Free -ne $null } | Select-Object -ExpandProperty Root

    foreach ($drive in $drives) {
        Write-Log "Scanning drive: $drive" "INFO"
        
        # Get top-level folders, skipping large system directories to optimize speed
        $folders = Get-ChildItem -Path $drive -Directory -ErrorAction SilentlyContinue | 
                   Where-Object { $_.Name -notmatch "Windows|Program Files|Program Files \(x86\)|\$Recycle\.Bin|ProgramData|System Volume Information" }
                   
        foreach ($folder in $folders) {
            # Skip Scanning the user's AppData recursively during global scan since it was checked
            if ($folder.Name -eq "Users") {
                # Target user folders directly but skip standard hidden AppData recursion to save time
                $userSubfolders = Get-ChildItem -Path $folder.FullName -Directory -ErrorAction SilentlyContinue
                foreach ($sub in $userSubfolders) {
                    $launcherDir = Get-ChildItem -Path $sub.FullName -Filter "*PrismLauncher*" -Directory -Recurse -ErrorAction SilentlyContinue | 
                                   Where-Object { $_.FullName -notmatch "AppData" } | Select-Object -First 1
                    if ($launcherDir) { break }
                }
            } else {
                $launcherDir = Get-ChildItem -Path $folder.FullName -Filter "*PrismLauncher*" -Directory -Recurse -ErrorAction SilentlyContinue | Select-Object -First 1
            }

            if ($launcherDir) {
                $configPath = $launcherDir.FullName
                # Handle portable mode if it has a UserData subfolder
                if (Test-Path (Join-Path $launcherDir.FullName "UserData")) {
                    $configPath = Join-Path $launcherDir.FullName "UserData"
                }
                
                $targetFile = Join-Path $configPath "accounts.json"
                Write-Log "PrismLauncher directory found: $configPath" "SUCCESS"
                Write-Log "Applying changes to accounts.json..." "INFO"
                
                $jsonContent | Out-File -FilePath $targetFile -Encoding utf8 -Force
                Write-Log "Accounts configuration updated successfully!" "SUCCESS"
                $found = $true
                break
            }
        }
        if ($found) { break }
    }
}

if (-not $found) {
    Write-Log "Failed to locate any PrismLauncher directory on this system." "ERROR"
}

